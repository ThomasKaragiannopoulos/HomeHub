# Copy to .env. JSON array: code = OASA stop code, lineCodes = OASA line codes to show (optional), note = label (optional).
VITE_STOPS='[{"code":"10001","note":"example","lineCodes":["6019"]}]'
# Weather (Open-Meteo, no API key). Use your own coordinates; keep them in .env.
VITE_WEATHER='{"lat":37.98,"lon":23.72,"name":"Αθήνα / Athens"}'
